#!/bin/bash

place=$(omarchy-weather-location 2>/dev/null)
if [[ -z $place ]]; then
  jq -cn '{ready: false}'
  exit
fi

location_file="$HOME/.local/state/omarchy/settings/weather.json"
target="$place"
if [[ -f $location_file ]]; then
  coordinates=$(jq -r '
    if (.latitude | type) == "number" and (.longitude | type) == "number"
    then "\(.latitude),\(.longitude)"
    else empty
    end
  ' "$location_file" 2>/dev/null)
  [[ -n $coordinates ]] && target="$coordinates"
fi

query=$(jq -rn --arg target "$target" '$target | @uri')
report=$(curl -fsS --max-time 8 "https://wttr.in/${query}?format=j1" 2>/dev/null) || {
  jq -cn --arg place "$place" '{ready: false, location: $place}'
  exit
}

jq -c --arg place "$place" '
  .current_condition[0] as $current |
  {
    ready: true,
    location: $place,
    temperature: ($current.temp_C | tonumber),
    feelsLike: ($current.FeelsLikeC | tonumber),
    weatherCode: ($current.weatherCode | tonumber),
    windSpeed: ($current.windspeedKmph | tonumber),
    humidity: ($current.humidity | tonumber)
  }
' <<< "$report"
