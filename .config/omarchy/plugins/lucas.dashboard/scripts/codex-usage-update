#!/usr/bin/python3
"""Update Omarchy's Codex usage record across Codex protocol versions.

This user-owned adapter applies compatibility fixes to Omarchy's packaged
collector, runs it, and atomically writes the record consumed by lucas.dashboard.
"""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

PACKAGED_COLLECTOR = Path("/usr/share/omarchy/bin/omarchy-agent-usage-codex")
REMOVED_CODEX_ARGUMENTS = '[codex, "-s", "read-only", "-a", "untrusted", "app-server"],'
COMPATIBLE_CODEX_ARGUMENTS = '[codex, "-s", "read-only", "-a", "never", "app-server"],'
BUFFERED_CODEX_RPC = "      text=True,\n      env=ENV,\n    )"
UNBUFFERED_CODEX_RPC = "      text=True,\n      bufsize=0,\n      env=ENV,\n    )"
SELECT_BASED_RPC_READ = """  deadline = time.time() + timeout
  while time.time() < deadline:
    ready, _, _ = select.select([proc.stdout], [], [], 0.25)
    if not ready:
      continue
    line = proc.stdout.readline()
    if not line:
      break
"""
NONBLOCKING_RPC_READ = """  os.set_blocking(proc.stdout.fileno(), False)
  deadline = time.time() + timeout
  while time.time() < deadline:
    try:
      line = proc.stdout.readline()
    except (BlockingIOError, TypeError):
      line = ""
    if not line:
      time.sleep(0.025)
      continue
"""
USAGE_RECORD = Path.home() / ".local/state/omarchy/agents/usage/codex.json"


def patched_collector_source() -> str:
    source = PACKAGED_COLLECTOR.read_text()
    # Codex 0.163 can emit several RPC messages in one write. Poll the
    # TextIOWrapper itself because select() cannot see lines it already read ahead.
    source = source.replace(BUFFERED_CODEX_RPC, UNBUFFERED_CODEX_RPC, 1)
    source = source.replace(SELECT_BASED_RPC_READ, NONBLOCKING_RPC_READ, 1)
    # Omarchy 4.0.1 used an approval policy removed by Codex 0.149.
    return source.replace(REMOVED_CODEX_ARGUMENTS, COMPATIBLE_CODEX_ARGUMENTS, 1)


def collect_codex_usage(collector_arguments: list[str]) -> dict:
    with tempfile.NamedTemporaryFile(mode="w", suffix=".py") as collector:
        collector.write(patched_collector_source())
        collector.flush()
        completed = subprocess.run(
            [sys.executable, collector.name, *collector_arguments],
            check=True,
            capture_output=True,
            text=True,
        )
    return json.loads(completed.stdout)


def write_usage_record(record: dict) -> None:
    USAGE_RECORD.parent.mkdir(parents=True, exist_ok=True)
    temporary_record = USAGE_RECORD.with_suffix(".json.tmp")
    temporary_record.write_text(json.dumps(record, indent=2) + "\n")
    os.replace(temporary_record, USAGE_RECORD)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    arguments = parser.parse_args()

    collector_arguments = []
    if arguments.force:
        collector_arguments.append("--force")
    if arguments.limits_only:
        collector_arguments.append("--limits-only")
    write_usage_record(collect_codex_usage(collector_arguments))


if __name__ == "__main__":
    main()
