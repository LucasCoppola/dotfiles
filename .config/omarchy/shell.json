{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "lucas.clock",
    "layout": {
      "left": [
        {
          "id": "lucas.dashboard"
        },
        {
          "id": "lucas.workspaces"
        }
      ],
      "center": [
        {
          "id": "lucas.indicators",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd"
          ]
        },
        {
          "id": "lucas.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.idle",
    "omarchy.lock"
  ]
}
